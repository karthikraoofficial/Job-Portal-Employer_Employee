# Copy this file to .env and fill in the values.

# --- Database ---------------------------------------------------------------
# Local: run `npm run db:start`, then `npx prisma dev ls` and paste the
# postgres:// URL it prints. Hosted: your provider's connection string
# (for Neon, the pooled one).
DATABASE_URL="postgres://user:password@localhost:5432/jobportal"

# Scratch database used only by `prisma migrate`. Leave empty for hosted
# databases. See "About migrations" in the README.
SHADOW_DATABASE_URL=""

# --- Auth -------------------------------------------------------------------
# Signs session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"
# The site's public address. Optional: if unset, it is taken from each request.
BETTER_AUTH_URL="http://localhost:3000"

# --- File storage -----------------------------------------------------------
# "local" writes uploaded resumes to UPLOAD_DIR on disk.
# "db" stores them in Postgres - use this on Vercel or any host without a
# persistent disk.
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# --- Demo -------------------------------------------------------------------
# "true" shows one-click demo account buttons on the login page.
# The accounts are created by `npm run db:seed`.
NEXT_PUBLIC_DEMO_MODE="false"
